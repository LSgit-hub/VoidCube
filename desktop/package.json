{
  "name": "voidcube-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform desktop shell for the VoidCube supervisor and CLI",
  "author": "VoidCube Contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "electron-vite preview",
    "pack": "npm run icons && npm run build && electron-builder --dir",
    "dist": "npm run icons && npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "6.0.0",
    "lucide": "0.554.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "png2icons": "2.0.1",
    "pngjs": "7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "io.voidcube.desktop",
    "productName": "VoidCube",
    "artifactName": "VoidCube-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/voidcube",
        "to": "voidcube"
      }
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "scripts/installer.nsh"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true
  }
}
