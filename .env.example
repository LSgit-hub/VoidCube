# VoidCube development environment example
#
# Copy secrets to VOIDCUBE_HOME/.env (default: ~/.VoidCube/.env).
# Use `voidcube api` to select the active API-A provider/model and to configure
# the separate API-B memory/governance model. This file does not select models.

# Provider credentials (set only the providers you use)
# OPENROUTER_API_KEY=sk-or-your-key-here
# DEEPSEEK_API_KEY=sk-your-key-here
# DASHSCOPE_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-key-here

# Shared Agnes-AI image/video generation key (configure via `/api`; never commit a real key)
# AGNES_API_KEY=sk-your-agnes-key-here

# Optional provider endpoint overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Internal root credential for Gateway service/session registration. This is
# process authentication, not a human-user account or login token.
# Set this in VOIDCUBE_HOME/.env for non-test deployments.
# GATEWAY_AUTH_TOKEN=replace-with-a-long-random-value

# Terminal backend override. The canonical setting is terminal.backend in
# VOIDCUBE_HOME/config.yaml.
TERMINAL_ENV=local
TERMINAL_CWD=.
TERMINAL_TIMEOUT=120

# Optional local web backend and diagnostics
WEB_BACKEND=local
DEBUG=false
# Stellar daily-companion voice transport. The derived local-owner template
# filters other speakers/background audio; it does not register a user account.
# Raw audio is deleted by default.
VOIDCUBE_VOICE_ENABLED=false
VOIDCUBE_VOICE_FINGERPRINT_PATH=runtime/voice/fingerprint.json
VOIDCUBE_VOICE_FINGERPRINT_THRESHOLD=0.50
VOIDCUBE_VOICE_WAKE_WORD=你好，星子
VOIDCUBE_VOICE_WAKE_KEYWORD_TOKENS=n ǐ h ǎo x īng z ǐ @你好星子
VOIDCUBE_VOICE_WAKE_WORD_REQUIRED=true
VOIDCUBE_VOICE_WAKE_CUE_ENABLED=true
VOIDCUBE_VOICE_SPEECH_START_TIMEOUT_SECONDS=8
VOIDCUBE_VOICE_SPEECH_END_SILENCE_SECONDS=3
VOIDCUBE_VOICE_MAX_UTTERANCE_SECONDS=45
VOIDCUBE_VOICE_VAD_THRESHOLD=0.5
VOIDCUBE_VOICE_WAKE_THRESHOLD=0.25
VOIDCUBE_VOICE_WAKE_SCORE=1.5
VOIDCUBE_STT_BASE_URL=
VOIDCUBE_STT_API_KEY=
VOIDCUBE_STT_MODEL=whisper-1
VOIDCUBE_STT_HOTWORDS=你好 星子 西子 VoidCube 语音系统
VOIDCUBE_TTS_PROVIDER=edge
VOIDCUBE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Daily-companion proactive reminder policy (local machine time, HH:MM).
# Empty DND values disable the window.
# Configure these in the canonical Supervisor service_runtime settings when needed.
