# VoidCube 项目通用编辑器配置
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{js,jsx,ts,tsx}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 4

# 以下文件不会被 Git 跟踪（通过 .gitignore）
# 但编辑器仍然应该知道它们不应被提交
