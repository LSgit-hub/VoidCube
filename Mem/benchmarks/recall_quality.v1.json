{
  "format": "voidcube.memory.recall-benchmark",
  "version": 1,
  "thresholds": {
    "recall_at_5": 1.0,
    "mrr": 0.8,
    "scope_leakage_rate": 0.0
  },
  "records": [
    {
      "source_type": "compressed",
      "id": "decision-backup",
      "owner_id": "owner-a",
      "workspace_id": "workspace-a",
      "title": "数据库迁移决策",
      "summary": "团队决定迁移前运行完整性检查并保留回滚备份。",
      "topics": ["数据库", "迁移", "备份"]
    },
    {
      "source_type": "compressed",
      "id": "decision-interface",
      "owner_id": "owner-a",
      "workspace_id": "workspace-a",
      "title": "界面主题决策",
      "summary": "设置页采用高对比度配色。",
      "topics": ["界面", "主题"]
    },
    {
      "source_type": "profile",
      "id": "profile-runtime",
      "owner_id": "owner-a",
      "workspace_id": "workspace-a",
      "subject": "user",
