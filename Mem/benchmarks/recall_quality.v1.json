    {
      "source_type": "turn",
      "id": "turn-release-window",
      "owner_id": "owner-a",
      "workspace_id": "workspace-a",
      "text": "Release window is Friday at 22:00 UTC."
    },
    {
      "source_type": "compressed",
      "id": "private-owner-b",
      "owner_id": "owner-b",
      "workspace_id": "workspace-b",
      "title": "数据库迁移决策",
      "summary": "Owner B uses an unrelated private migration plan.",
      "topics": ["数据库", "迁移"]
    }
  ],
  "cases": [
    {
      "name": "multilingual durable decision",
      "query": "我们之前对数据库迁移和备份做了什么决定",
